# URL e chiave pubblica del tuo progetto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key (Project Settings > API) - SOLO lato server, mai esposta al client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Chiavi VAPID per le notifiche push - generale con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tommaso.alvares@gmail.com

# Segreto condiviso per proteggere l'endpoint del cron dei promemoria
CRON_SECRET=cambia-questo-valore
